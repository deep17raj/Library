# Copy to .env and fill in. Never commit .env.

# NODE_ENV=production makes JWT_SECRET mandatory and cookies Secure.
NODE_ENV=development

# Local only. On cPanel leave PORT unset: Passenger provides it.
PORT=5060

# Public address of the site (QR codes, links in notifications).
APP_BASE_URL=http://localhost:5060

# MySQL / MariaDB. Either DATABASE_URL or the DB_* values.
# DATABASE_URL=mysql://user:password@localhost:3306/study_library
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=study_library

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=

# Platform owner login, created on the FIRST boot only. Change the password in the
# app afterwards; editing these later does nothing.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Owner

# Optional: where uploads are kept (default server/storage). Keep it outside the
# upload folder you replace when deploying.
# STORAGE_DIR=/home/CPUSER/library-storage

# Optional: integration tests (the database named here is dropped and recreated;
# its name must end in _test).
# TEST_DATABASE_URL=mysql://root:password@localhost:3306/study_library_test
